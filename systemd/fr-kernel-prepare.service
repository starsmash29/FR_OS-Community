[Unit]
Description=FR_OS kernel updates: get Debian's newer kernel ready to try (ROADMAP SEC-14)
Documentation=https://github.com/starsmash29/FR_OS-Community
# Asks apt which kernel Debian's linux-image-amd64 points at and, when it
# is newer than every kernel here and update.kernel_updates is on (the
# default), installs it into the persistent root and makes its initrd
# from the image's own (apply/kernelupdate.go, held to 1.x's
# frfw.kernel_update). It never stages or reboots: the Update screen's
# "Try it" does, an admin's decision. Only on a live router with
# persistence -- an installed system updates its kernel in place.
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=persistence
After=network-online.target apt-daily.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/fr_os/firewall-cli kernel prepare
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# dpkg installs a kernel package: it writes /boot, /usr/lib/modules,
# /var/lib/dpkg, /etc (the kernel's hooks) and runs the package's
# maintainer scripts -- the file system stays writable and the modules
# directory too, as for 1.x's unit. What it never needs is shut: no new
# privileges, no home directories, no devices, kernel logs or clock, no
# namespaces, no setuid files; it talks to the Debian archive only
# through apt.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
