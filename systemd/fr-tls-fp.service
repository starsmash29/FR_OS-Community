[Unit]
Description=FR_OS TLS client fingerprinting daemon
Documentation=https://github.com/starsmash29/FR_OS-Community
After=fr-apply-helper.socket
Wants=fr-apply-helper.socket

[Service]
Type=simple
# Starts as root only to open the XDP program's pinned ring buffer
# (CAP_BPF), then becomes fr_os-sensor for good, with fr_os-feeds to
# reach the apply-helper's socket, before reading any packet data
# (fros_xdp::privdrop). It reads /etc/fr_os/sensor-view.json, which an
# apply writes, and keeps its inventory under /etc/fr_os/sensors.
ExecStart=/usr/libexec/fr_os/fr-tls-fp
Restart=always
RestartSec=5
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# Root only long enough to open a pinned BPF map: nothing but CAP_BPF and
# what becoming fr_os-sensor takes. /sys stays writable (no
# ProtectKernelTunables): the pinned maps live on bpffs under it.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os/sensors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_BPF CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
