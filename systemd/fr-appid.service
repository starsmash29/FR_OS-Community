[Unit]
Description=FR_OS application identification daemon
Documentation=https://github.com/starsmash29/FR_OS-Community
After=network.target

[Service]
Type=simple
# Parses what LAN hosts send, so it runs as fr_os-sensor from the start
# and never as root: it reads the sensors' view of the config
# (/etc/fr_os/sensor-view.json, which an apply writes; never config.yaml),
# follows the resolver's query log and the XDP filter's event file,
# readable through fr_os-feeds (ROADMAP SEC-4, SEC-11), and writes only
# its display-only usage file under /etc/fr_os/sensors. It never talks
# to the apply-helper. While app_control turns on no source it idles,
# reading the view again every 30 seconds.
User=fr_os-sensor
Group=fr_os-sensor
SupplementaryGroups=fr_os-feeds
ExecStart=/usr/libexec/fr_os/fr-appid
Restart=on-failure
RestartSec=5
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go), as
# 1.x's unit has it: no capability at all, Unix sockets only.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os/sensors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
