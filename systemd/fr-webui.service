[Unit]
Description=FR_OS webUI
Documentation=https://github.com/starsmash29/FR_OS-Community
After=fr-apply-helper.socket network.target
Wants=fr-apply-helper.socket

[Service]
Type=simple
User=fr_os-webui
Group=fr_os-webui
# fr_os-feeds reaches the apply-helper socket (ROADMAP SEC-11). No
# journal access (ROADMAP SEC-4): what the webUI shows of the system
# comes through the apply-helper.
SupplementaryGroups=fr_os-feeds
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Unlike 1.x, no OPENSSL_CONF: Go's TLS doesn't read OpenSSL's config,
# and its default key exchange already prefers X25519MLKEM768; with PQC
# on, fr-webui is TLS 1.3-only itself.
ExecStart=/usr/libexec/fr_os/fr-webui
Restart=on-failure
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# The webUI writes only its own state: accounts, sessions, the login
# guard, its certificate.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/fr_os/webui
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
