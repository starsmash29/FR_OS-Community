[Unit]
Description=FR_OS privileged update-helper (root-run; the webUI's Update screen talks to it over fr-update-helper.socket)
Documentation=https://github.com/starsmash29/FR_OS-Community
Requires=fr-update-helper.socket
After=fr-update-helper.socket

[Service]
Type=simple
ExecStart=/usr/libexec/fr_os/fr-update-helper
Restart=on-failure
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# Root, because it installs a signed release (apply/update.go): the
# programs into /usr/libexec/fr_os-releases/<version>/ and the
# /usr/libexec/fr_os symlink switched to them, the XDP program, the
# units and drop-ins, the verified release kept in /opt/fr_os/releases,
# its history in /etc/fr_os; it stages a kernel on the persistence
# partition (outside the overlay, /run/live/persistence) and asks
# systemd to restart what an update changed, to start
# fr-kernel-prepare.service or to reboot into a trial -- never the kernel
# itself. It holds no capability: every file it writes is root's. It
# reaches the internet only to download a release an admin asked for
# that isn't in the cache yet (GitHub's release files, which verify or
# are refused).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/run/live/persistence -/var/log/fr_os /etc/fr_os /etc/systemd /etc/sysctl.d /usr/libexec /usr/local/share/fr_os /opt/fr_os
ProtectHome=yes
UMask=0077
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@privileged @resources @clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap @mount
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
Also=fr-update-helper.socket
