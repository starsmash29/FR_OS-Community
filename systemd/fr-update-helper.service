[Unit]
Description=FR_OS privileged update-helper (root-run; the webUI's Update screen talks to it over fr-update-helper.socket)
Documentation=https://github.com/starsmash29/FR_OS-Community
Requires=fr-update-helper.socket
After=fr-update-helper.socket

[Service]
Type=simple
ExecStart=/usr/libexec/fr_os/fr-update-helper
Restart=on-failure
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# Root, because it stages a kernel on the persistence partition (outside
# the overlay, /run/live/persistence) and asks systemd to start
# fr-kernel-prepare.service or to reboot into a trial -- never the kernel
# itself. It writes nothing else but the audit log's security alerts,
# holds no capability, and talks to nothing but systemd and netlink
# (what works now, for the trial to work again: SEC-23). 1.x's signed
# release install comes with phase 4f-4.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/run/live/persistence -/var/log/fr_os
ProtectHome=yes
UMask=0077
ProtectProc=invisible
IPAddressDeny=any
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@privileged @resources @clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap @mount
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=

[Install]
Also=fr-update-helper.socket
