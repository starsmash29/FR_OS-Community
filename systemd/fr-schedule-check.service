[Unit]
Description=FR_OS scheduled rules kept right across DST and zone changes, and the rule hit counters recorded
Documentation=https://github.com/starsmash29/FR_OS-Community
After=fr-firewall.service
ConditionPathExists=/etc/fr_os/config.yaml

[Service]
Type=oneshot
ExecStart=/usr/libexec/fr_os/firewall-cli schedule-check /etc/fr_os/config.yaml
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# Root, because it reads nft's counters and a refresh is an apply: the
# apply-helper's own sandbox.
ProtectSystem=strict
ReadWritePaths=-/etc/fr_os -/etc/kea -/etc/ssh/sshd_config.d -/usr/local/share/fr_os -/sys/fs/bpf -/var/log/fr_os
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_IPC_LOCK CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL
