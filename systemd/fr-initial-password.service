[Unit]
Description=FR_OS: remove the initial admin password from the console once changed (firewall-cli initial-password)
Documentation=https://github.com/starsmash29/FR_OS-Community

[Service]
Type=oneshot
ExecStart=/usr/libexec/fr_os/firewall-cli initial-password
# Sandbox (security-lessons I1; checked by systemd/sandbox_test.go).
# Root: reads the webUI's account file (hence CAP_DAC_READ_SEARCH: it is
# fr_os-webui's, 0600) and rewrites the root-only console notice. It
# only checks the password, never signs in, so it never writes the
# account file.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/issue.d -/etc/issue
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
