#!/bin/sh
# Runs inside the live-build chroot, after packages and includes.chroot
# are in place. Installs FR_OS: the Go and Rust binaries, the XDP
# program, the scripts and the systemd units, all built on the build host
# and staged into /opt/fr_os-stage by installer/build-live-image.sh --
# the image has no compiler and no toolchain. Then enables what the image
# starts on its first real boot: fr-first-boot (which enables everything
# else, see scripts/fr-first-boot.sh), fr-persistence-setup and
# fr-firewall (the fail-closed baseline).
set -e

STAGE=/opt/fr_os-stage
LIBEXEC=/usr/libexec/fr_os

echo "fr_os: installing the binaries into $LIBEXEC..."
install -d -m 0755 "$LIBEXEC"
for bin in "$STAGE"/bin/*; do
    install -m 0755 "$bin" "$LIBEXEC/"
done
install -m 0755 "$STAGE/scripts/fr-first-boot.sh" "$LIBEXEC/fr-first-boot.sh"
install -m 0755 "$STAGE/scripts/install-system-integration.sh" "$LIBEXEC/install-system-integration.sh"
# `firewall-cli` on the console's PATH, as 1.x's was.
ln -sf "$LIBEXEC/firewall-cli" /usr/sbin/firewall-cli

# The XDP SNI filter's program (ROADMAP P4-1), compiled by the image
# build from crates/fros-xdp-ebpf: fr-xdp loads exactly this file
# (apply.Paths.XdpObject).
install -D -m 0644 "$STAGE/bpf/xdp_sni_filter.o" /usr/local/share/fr_os/bpf/xdp_sni_filter.o

# The WireGuard module is loaded at boot (security-lessons G8), so the
# sandboxed units that apply the config (ProtectKernelModules=yes) never
# have to load it themselves.
echo wireguard > /etc/modules-load.d/fr_os-wireguard.conf

# The journal's size and age limit, and the kernel's log backend for the
# ruleset's drop log (security-lessons K6).
echo nf_log_syslog > /etc/modules-load.d/fr_os-logging.conf
install -D -m 0644 "$STAGE/systemd/journald-fr_os.conf" /etc/systemd/journald.conf.d/fr_os.conf

# The hardware watchdog, when the machine has one: a hang resets the
# machine (ROADMAP SEC-14).
install -D -m 0644 "$STAGE/systemd/watchdog-fr_os.conf" /etc/systemd/system.conf.d/fr_os-watchdog.conf

# Loopback only: FR_OS owns the network ports (the apply gives the LAN
# its address), and fr-first-boot adds a DHCP client for the WAN port
# alone. live-boot keeps this file because of `ip=frommedia` (auto/config).
cat > /etc/network/interfaces <<'CONF'
# FR_OS configures the network ports itself; the only DHCP client is
# the WAN port's, in /etc/network/interfaces.d/fr_os-wan (fr-first-boot).
auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*
CONF

echo "fr_os: installing the systemd units..."
for unit in "$STAGE"/systemd/*.service "$STAGE"/systemd/*.socket "$STAGE"/systemd/*.timer "$STAGE"/systemd/*.path; do
    if [ -f "$unit" ]; then
        install -m 0644 "$unit" /etc/systemd/system/
    fi
done

# agetty's drop-in directory: the console's port summary and the first
# boot's password go there (firewall-cli console-ports, initial-password).
install -d -m 0755 /etc/issue.d

systemctl enable fr-first-boot.service
systemctl enable fr-persistence-setup.service
# From the very first boot: until fr-first-boot has written a config this
# loads the fail-closed baseline, so the WAN (DHCP'd by live-boot) is
# never up unfiltered.
systemctl enable fr-firewall.service
# ROADMAP SEC-18: Debian's own nftables.service loads /etc/nftables.conf,
# which starts with `flush ruleset`, and its stop action flushes the
# ruleset too: enabled by anyone, it would replace or wipe the FR_OS
# ruleset, and both units start before network-pre.target. FR_OS loads
# the ruleset itself (fr-firewall), so mask the unit -- it can't be
# started, enabled or pulled in. The package stays: it provides `nft`.
systemctl mask nftables.service

echo "fr_os: removing the staged build..."
rm -rf "$STAGE"
